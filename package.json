{
  "name": "@xmsthc/studio-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reusable darkroom-style React workbench components",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SurpassHR/studio-ui.git"
  },
  "homepage": "https://github.com/SurpassHR/studio-ui#readme",
  "bugs": {
    "url": "https://github.com/SurpassHR/studio-ui/issues"
  },
  "license": "UNLICENSED",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/studio-ui.css",
    "./tokens.css": "./dist/studio-tokens.css"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && cat src/styles/tokens.css src/styles/base.css dist/studio-ui.css > dist/studio-ui.combined.css && mv dist/studio-ui.combined.css dist/studio-ui.css && cp src/styles/tokens.css dist/studio-tokens.css",
    "prepack": "npm run build",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:react18": "node scripts/react18-smoke.mjs",
    "test:pack": "node scripts/pack-smoke.mjs",
    "dev:gallery": "vite --config gallery/vite.config.ts",
    "build:gallery": "vite build --config gallery/vite.config.ts",
    "preview:gallery": "vite preview --config gallery/vite.config.ts",
    "test:gallery": "playwright test -c gallery/playwright.config.ts"
  },
  "peerDependencies": {
    "react": ">=18.3 <20",
    "react-dom": ">=18.3 <20"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "jsdom": "^29.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "~5.9.0",
    "vite": "^7.2.0",
    "vitest": "^4.1.9"
  }
}
